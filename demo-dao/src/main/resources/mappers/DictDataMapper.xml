<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.dict.dao.mapper.DictDataMapper">

	<sql id="queryCondition">
		<if test="typeId != null">
			AND t.`type_id` = #{typeId}
		</if>
		<if test="typeValue != null and typeValue != ''">
			AND t.`type_value` = #{typeValue}
		</if>
		<if test="typeValues != null and typeValues.length > 0">
			AND t.`type_value` IN
			<foreach collection="typeValues" item="typeValue" open="(" close=")" separator=",">#{typeValue}</foreach>
		</if>
		<if test="name != null and name != ''">
			AND t.`name` LIKE #{name,typeHandler=com.example.demo.framework.mybatis.type.WildcardTypeHandler}
		</if>
		<if test="status != null and status != ''">
			AND t.`status` = #{status}
		</if>
	</sql>

	<select id="count" parameterType="dictDataDO" resultType="java.lang.Long">
		SELECT COUNT(*)
		  FROM `tb_dict_data` t
		 WHERE t.`is_deleted` = 0
		<include refid="queryCondition"/>
	</select>

	<select id="list" parameterType="dictDataDO" resultType="dictDataDO">
		SELECT t.`id`,
			   t.`type_id` AS typeId,
			   t.`type_value` AS typeValue,
			   t.`name`,
			   t.`value`,
			   t.`remark`,
			   t.`sort_order`,
			   t.`status`,
			   t.`create_time` AS createTime
		  FROM `tb_dict_data` t
		 WHERE t.`is_deleted` = 0
		<include refid="queryCondition"/>
		 ORDER BY t.`type_id`, t.`sort_order`, t.`id` DESC
		<if test="pageNo != null and pageNo > 0 and pageSize != null and pageSize > 0">
			LIMIT #{offset}, #{pageSize}
		</if>
	</select>

</mapper>
