<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.corp.dao.mapper.CorpMapper">

	<select id="countCorp" parameterType="corpDO" resultType="java.lang.Long">
		SELECT COUNT(1)
		  FROM `tb_corp` t
		 WHERE t.`is_deleted`= 0
	</select>

	<select id="listCorps" parameterType="corpDO" resultType="corpDO">
		SELECT t.`id`,
			   t.`name`
		  FROM `tb_corp` t
		 WHERE t.`is_deleted`= 0
	</select>

</mapper>
