<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.dict.dao.mapper.DictDataMapper">

	<sql id="queryCondition">
		<if test="typeId != null">
		<![CDATA[ AND t.`type_id` = #{typeId} ]]>
		</if>
		<if test="typeValue != null and typeValue != ''">
		<![CDATA[ AND t.`type_value` = #{typeValue} ]]>
		</if>
		<if test="typeValues != null and typeValues.length > 0">
		<![CDATA[ AND t.`type_value` IN ]]>
			<foreach collection="typeValues" item="typeValue" open="(" close=")" separator=",">#{typeValue}</foreach>
		</if>
		<if test="name != null and name != ''">
		<![CDATA[ AND t.`name` LIKE #{name,typeHandler=com.example.demo.framework.mybatis.type.WildcardTypeHandler} ]]>
		</if>
		<if test="status != null and status != ''">
		<![CDATA[ AND t.`status` = #{status} ]]>
		</if>
	</sql>

	<select id="countData" parameterType="dictDataDO" resultType="java.lang.Long">
	<![CDATA[
		SELECT COUNT(*)
		  FROM `tb_dict_data` t
		 WHERE t.`is_deleted` = 0
	]]>
		<include refid="queryCondition"/>
	</select>

	<select id="listDatas" parameterType="dictDataDO" resultType="dictDataDO">
	<![CDATA[
		SELECT t.`id`,
			   t.`type_id` AS typeId,
			   t.`type_value` AS typeValue,
			   t.`name`,
			   t.`value`,
			   t.`remark`,
			   t.`order`,
			   t.`status`,
			   t.`create_time` AS createTime
		  FROM `tb_dict_data` t
		 WHERE t.`is_deleted` = 0
  	]]>
		<include refid="queryCondition"/>
	<![CDATA[
		 ORDER BY t.`type_id`, t.`order`, t.`id` DESC
		 LIMIT #{offset}, #{pageSize}
	]]>
	</select>

	<select id="getData" parameterType="dictDataDO" resultType="dictDataDO">
	<![CDATA[
		SELECT t.`id`,
			   t.`type_id` AS typeId,
			   t.`type_value` AS typeValue,
			   t.`name`,
			   t.`value`,
			   t.`remark`,
			   t.`order`,
			   t.`status`
		  FROM `tb_dict_data` t
		 WHERE t.`is_deleted` = 0
  	]]>
		<if test="id != null">
		<![CDATA[ AND t.`id` = #{id} ]]>
		</if>
		<if test="typeValue != null and typeValue != ''">
		<![CDATA[ AND t.`type_value` = #{typeValue} ]]>
		</if>
		<if test="value != null and value != ''">
		<![CDATA[ AND t.`value` = #{value} ]]>
		</if>
		<if test="status != null and status != ''">
		<![CDATA[ AND t.`status` = #{status} ]]>
		</if>
	<![CDATA[
		 ORDER BY t.`id` DESC
		 LIMIT 1
	]]>
	</select>

</mapper>
